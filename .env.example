# ─────────────────────────────────────────────────────────────────────────
#  StudyAlign example apps: environment template.
#  Copy to .env and fill in real values:   cp .env.example .env
#  .env is gitignored and must NEVER be committed. On the server it is created
#  once and survives every pull.
# ─────────────────────────────────────────────────────────────────────────

# Which Compose files a bare `docker compose` command picks up.
#   Local dev  :  docker-compose.yml:docker-compose.dev.yml
#   Production :  docker-compose.yml:docker-compose.prod.yml   (set this on the server)
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# Host port the nginx reverse proxy publishes in dev / base (prod removes it).
PROXY_PORT=8080

# The StudyAlign backend the demo apps log interactions to. Baked into the
# frontend builds at build time (Vite inlines VITE_* vars).
# Point this at your own StudyAlign backend; the public dev backend is the default.
VITE_STUDY_ALIGN_URL=https://backend.studyalign.com